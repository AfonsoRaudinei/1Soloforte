{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "SoloForte (Dev Web)",
            "request": "launch",
            "type": "dart",
            "args": [
                "-d",
                "chrome",
                "--web-port=5000",
                "--web-renderer",
                "html",
                "--dart-define=ENV=dev",
                "--dart-define=API_KEY=dev_key_12345"
            ]
        },
        {
            "name": "SoloForte (Prod)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--release",
                "--dart-define=ENV=prod"
            ]
        }
    ]
}